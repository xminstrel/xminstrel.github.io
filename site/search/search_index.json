11\u5f88\u5927\u7684\u5e2e\u52a9\uff0c\u4e8e\u662f\u840c\u751f\u4e86\u642d\u5efa\u81ea\u5df1\u7684\u535a\u5ba2\u7684\u60f3\u6cd5\u3002   \u5982\u4f60\u6240\u89c1\uff0c\u8fd9\u662f\u6211\u5c1d\u8bd5\u642d\u5efa\u7684\u4e00\u4e2a\u5c0f\u7ad9\uff0c\u5206\u4eab\u6211\u7684\u4e00\u4e9b\u8bfe\u7a0b\u7b14\u8bb0\u548c\u751f\u6d3b\u788e\u7247 \u611f\u8c22@Hollow Dobt \u7684\u5e2e\u52a9\uff0c\u6211\u521d\u6b65\u5efa\u6210\u4e86\u8fd9\u4e2a\u7b80\u6613\u7684\u7f51\u7ad9\u3002</p>"},{"location":"ai/tools/","title":"AI\u5de5\u5177\u548c\u8d44\u6e90","text":"<p>\u6b64\u5904\u7528\u6765\u5b58\u653e\u4e00\u4e9bAI\u76f8\u5173\u7684\u5de5\u5177\uff1f</p>"},{"location":"control/","title":"\u6d4b\u8bd5","text":""},{"location":"control/esp32/","title":"Esp32 \u5165\u95e8","text":"<p>\u542f\u771f\u95ee\u5b66\u7684\u9879\u76ee\u53ef\u80fd\u8981\u7528\u5230esp32\u6765\u63a7\u5236\uff0c\u6253\u7b97\u5728\u5bd2\u5047\u6839\u636e\u6559\u7a0b\u5b66\u4e60\u4e00\u4e0b\u4f7f\u7528 \u00a0</p> <p>\u592a\u6781\u521b\u5ba2 </p> <p>\u4e00\u4e2a\u7b80\u5355\u7684ESP32\u6559\u7a0b</p> <p>\u9996\u5148\u5728 ESP \u7f16\u7a0b\u73af\u5883\u914d\u7f6e\u5c31\u8e29\u4e86\u5751 \u5728\u5b89\u88c5 ESP 32 \u5f00\u53d1\u73af\u5883\u65f6\uff0c\u4e0d\u63a8\u8350\u76f4\u63a5\u5728 Arduino \u4e2d\u4e0b\u8f7d\uff0c\u6211\u5c1d\u8bd5\u4e86\u76f4\u63a5\u4e0b\u8f7d\u3001\u955c\u50cf\u6e90\u4e0b\u8f7d\uff0c\u6700\u7ec8\u90fd\u8d85\u65f6\u4e86\u3002\u63a8\u8350\u91c7\u7528\u79bb\u7ebf\u5b89\u88c5\u5305\u5f62\u5f0f\u4e0b\u8f7d\u3002</p>"},{"location":"control/esp32/#led","title":"LED \u706f\u5e73\u79fb\uff1a","text":"<p>\u70b9\u51fb\u67e5\u770b\u5b8c\u6574\u4ee3\u7801</p> <pre><code>//\u5b9a\u4e49\u5f15\u811a\u6570\u7ec4\n\nint pin_list[5] = { 13, 12, 14, 27, 26 };\n\n//\u83b7\u5f97\u6570\u7ec4\u957f\u5ea6\n\nint size = sizeof(pin_list) / sizeof(pin_list[0]);\n\n\n\nvoid setup() {\n\n\u00a0 // \u8bbe\u5b9aGPIO\u5f15\u811a\u4e3a\u8f93\u51fa\u6a21\u5f0f\n\n\u00a0 for (int i = 0; i &lt; size; i++) {\n\n\u00a0 \u00a0 pinMode(pin_list[i], OUTPUT);\n\n\u00a0 }\n\n}\n\n\nvoid loop() {\n\n\u00a0 // \u6240\u6709\u5f15\u811a\u8bbe\u7f6e\u4e3a\u9ad8\u7535\u5e73\n\n\u00a0 for (int i = 0; i &lt; size; i++) {\n\n\u00a0 \u00a0 digitalWrite(pin_list[i], HIGH);\n\n\u00a0 \u00a0 if (i &gt; 0) {\n\n\u00a0 \u00a0 \u00a0 digitalWrite(pin_list[i - 1], LOW);\n\n\u00a0 \u00a0 } else {\n\n\u00a0 \u00a0 \u00a0 digitalWrite(pin_list[size - 1], LOW);\n\n\u00a0 \u00a0 }\n\n\u00a0 \u00a0 delay(250);\n\n\u00a0 }\n\n}\n</code></pre>"},{"location":"control/esp32/#_1","title":"\u6570\u7801\u7ba1\u663e\u793a","text":""},{"location":"control/%E6%8E%A7%E5%88%B6%E8%AE%BA/","title":"\u63a7\u5236\u8bba","text":"<p>zju\u7684\u901a\u8bc6\u6838\u5fc3\u8bfe\u7a0b \u672c\u9875\u7528\u6765\u5b58\u653e\u8bfe\u7a0b\u7b14\u8bb0\u548c\u8d44\u6599</p> <p>\u671f\u672b\u8d44\u6599</p> <p>\u770b\u5230\u670b\u53cb\u7684\u5e16\u5b50\u6240\u4ee5\u5148\u8bb0\u4e0b\u6765   \u91cd\u70b9\u590d\u4e60\uff1a\u7cfb\u7edf\u6d41\u7a0b\u56fe\u8f93\u51fa\u8ba1\u7b97\u548c\u7a33\u5b9a\u6027\u8ba1\u7b97 - 2023-2024\u6625\u590f\u63a7\u5236\u8bba\u56de\u5fc6\u5377\u53ca\u8d44\u6599\u603b\u7ed3 - 25-26\u5b66\u5e74\u79cb\u51ac\u5b66\u671f\u63a7\u5236\u8bba\u671f\u672b\u8003\u8bd5\u56de\u5fc6\u5377 - 24-25\u6625\u590f\u63a7\u5236\u8bba\u671f\u672b\u8bd5\u5377 </p>"},{"location":"control/%E8%87%AA%E5%8A%A8%E6%8E%A7%E5%88%B6%E7%90%86%E8%AE%BA/","title":"\u81ea\u52a8\u63a7\u5236\u7406\u8bba","text":"<p>\u4e13\u4e1a\u8bfe\u7a0b\uff0c\u8bb0\u5f55\u4e00\u4e9b\u7b14\u8bb0  </p>"},{"location":"others/","title":"emm","text":"<p>\u968f\u673a\u6389\u843d\u751f\u6d3b\u788e\u7247...</p>"},{"location":"zju-courses/%E6%9D%90%E6%96%99%E5%8A%9B%E5%AD%A6/%E6%9D%90%E6%96%99%E5%8A%9B%E5%AD%A6/","title":"\u6750\u6599\u529b\u5b66","text":"<p>\u8bb0\u5f55\u8bfe\u7a0b\u5b66\u4e60\u7b14\u8bb0</p>"}]}